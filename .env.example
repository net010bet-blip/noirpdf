# Copy to .env. Generate your own database password; never commit .env.
POSTGRES_PASSWORD=
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
FILE_TTL_SECONDS=3600
# Direct local development uses SQLite and bounded subprocesses by default.
# DATABASE_URL=postgresql+psycopg://noir:your-password@localhost:5432/noirpdf
# EXECUTOR=celery
# REDIS_URL=redis://localhost:6379/0
# DATA_DIR=/workspace/data
# API_URL=http://127.0.0.1:8000

# Optional AI provider. Disabled while URL/model are empty.
# An Ollama local endpoint can be free. A cloud provider may charge you.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_MAX_INPUT_CHARS=60000
AI_MAX_OUTPUT_TOKENS=4096
# Native advanced engines (Docker supplies these paths automatically):
# LIBREOFFICE_BIN=/usr/bin/libreoffice
# OCRMYPDF_BIN=/usr/bin/ocrmypdf
# VERAPDF_BIN=/opt/verapdf/verapdf
# CHROMIUM_BIN=/usr/bin/chromium
# HTML_ENABLED=true
# HTML_CHROMIUM_SANDBOX=false # only in the isolated container
